{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Locaryn",
  "version": "0.1.10",
  "identifier": "dev.locaryn.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Locaryn",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost https://asset.localhost; img-src 'self' data: asset: http://asset.localhost https://asset.localhost blob:; media-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost https://huggingface.co http://127.0.0.1 http://localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": []
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["locaryn"]
      }
    },
    "updater": {
      "endpoints": ["https://github.com/TeALO36/Locaryn/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5QkMwNjMzNTNFMDJFODIKUldTQ0x1QlRNd2E4NlVCYmNTKzY0Q3A2YmFvL29pbHdXejlFVWI1M3VYcWZEdlJLcWIxUkt0TzMK"
    }
  }
}
