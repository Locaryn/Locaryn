{
  "name": "locaryn-workspace",
  "version": "0.3.43",
  "private": true,
  "description": "Open-core agentic coding platform — desktop + CLI + secured remote server, sharing one Rust core.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "install:all": "pnpm install",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "tauri:dev": "pnpm --filter @locaryn/desktop tauri dev",
    "tauri:build": "pnpm --filter @locaryn/desktop tauri build",
    "cargo:check": "cargo check --workspace",
    "cargo:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "cargo:test": "cargo test --workspace",
    "dev:win": "scripts\\dev.bat",
    "dev:unix": "bash scripts/dev.sh",
    "build:servers:win": "powershell -ExecutionPolicy Bypass -File scripts\\build-servers.ps1",
    "build:servers:unix": "bash scripts/build-servers.sh",
    "build:servers:win:personal": "powershell -ExecutionPolicy Bypass -File scripts\\build-servers.ps1 -Personal",
    "build:servers:unix:personal": "PERSONAL=1 bash scripts/build-servers.sh",
    "build:servers:unix:deb": "bash scripts/build-server-deb.sh",
    "build:servers:unix:deb:personal": "PERSONAL=1 bash scripts/build-server-deb.sh",
    "build:desktop:win": "powershell -ExecutionPolicy Bypass -File scripts\\build-desktop.ps1",
    "build:desktop:unix": "bash scripts/build-desktop.sh",
    "build:all:win": "powershell -ExecutionPolicy Bypass -File scripts\\build-all.ps1",
    "build:all:unix": "bash scripts/build-all.sh",
    "build:all:win:personal": "powershell -ExecutionPolicy Bypass -File scripts\\build-all.ps1 -Personal",
    "build:all:unix:personal": "PERSONAL=1 bash scripts/build-all.sh",
    "package:win": "powershell -ExecutionPolicy Bypass -File scripts\\package.ps1",
    "package:unix": "bash scripts/package.sh",
    "package:plugins": "powershell -ExecutionPolicy Bypass -File scripts\\package-plugins.ps1",
    "clean:win": "scripts\\clean.bat",
    "clean:unix": "bash scripts/clean.sh",
    "ci": "pnpm install --frozen-lockfile && pnpm typecheck && pnpm lint && cargo fmt -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.6.3"
  }
}
