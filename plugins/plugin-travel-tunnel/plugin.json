{
  "$schema": "https://locaryn.dev/schema/plugin.json/v0.1",
  "apiVersion": "0.1",
  "name": "plugin-remote",
  "version": "1.0.0",
  "description": "Remote access with encrypted outbound tunnels (Cloudflare, ngrok, devtunnel) and QR pairing.",
  "author": "Locaryn Team",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Locaryn/plugin-travel-tunnel",
  "repository": "https://github.com/Locaryn/plugin-travel-tunnel",
  "keywords": ["remote-mode", "remote-access", "tunnels", "cloudflare", "ngrok", "qr-pairing"],
  "permissions": {
    "network": true
  },
  "capabilities": ["travel-tunnel"],
  "ui_contributions": {
    "settings_tabs": [
      {
        "id": "remote-settings",
        "label": "Remote & Tunnels",
        "icon": "cloud"
      }
    ]
  }
}
