{
  "$schema": "https://locaryn.dev/schema/plugin.json/v0.1",
  "apiVersion": "0.1",
  "name": "plugin-voice-tts",
  "version": "1.0.0",
  "description": "Voice synthesis & voice cloning extension (Kokoro-82M, Qwen3-TTS, Piper ONNX).",
  "author": "Locaryn Team",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Locaryn/plugin-voice-tts",
  "repository": "https://github.com/Locaryn/plugin-voice-tts",
  "keywords": [
    "voice-tts",
    "text-to-speech",
    "voice-cloning",
    "kokoro",
    "qwen3-tts"
  ],
  "permissions": {
    "files_read": true,
    "files_write": true,
    "shell": false
  },
  "capabilities": [
    "voice-tts",
    "voice-cloning"
  ],
  "ui_contributions": {
    "nav_items": [
      {
        "id": "studio",
        "label": "Studio de génération",
        "icon": "image"
      }
    ],
    "studio_tabs": [
      {
        "id": "audio",
        "label": "Synthèse vocale",
        "icon": "mic"
      }
    ],
    "composer_actions": [
      {
        "id": "read_aloud",
        "label": "Lire à voix haute",
        "icon": "sound",
        "action": "tool",
        "value": "generate_speech",
        "hint": "Faire dire le texte du champ par la voix choisie"
      }
    ],
    "settings_sections": [
      {
        "id": "voix",
        "label": "Synthèse vocale",
        "fields": [
          {
            "id": "model",
            "type": "model",
            "label": "Modèle de voix",
            "hint": "Kokoro parle sans échantillon ; les autres demandent une voix de référence."
          },
          {
            "id": "speed",
            "type": "select",
            "label": "Débit",
            "options": [
              "lent",
              "normal",
              "rapide"
            ],
            "default": "normal"
          }
        ]
      }
    ]
  }
}
