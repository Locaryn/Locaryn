# ─────────────────────────────────────────────────────────────────────────
# Rust
# ─────────────────────────────────────────────────────────────────────────
/target
**/target
**/*.rs.bk
Cargo.lock.bak

# ─────────────────────────────────────────────────────────────────────────
# Node / pnpm
# ─────────────────────────────────────────────────────────────────────────
node_modules/
dist/
.vite/
.turbo/
*.tsbuildinfo
pnpm-debug.log*

# ─────────────────────────────────────────────────────────────────────────
# Tauri — bureau
# ─────────────────────────────────────────────────────────────────────────
apps/desktop/src-tauri/target/
apps/desktop/dist/
apps/desktop/.tauri/

# ─────────────────────────────────────────────────────────────────────────
# Tauri — mobile / Android
#
# `gen/android` est régénéré par `tauri android init`. Le projet Gradle est
# suivi, mais jamais ce qu'il produit : un seul .so de débogage pèse 153 Mo.
# ─────────────────────────────────────────────────────────────────────────
**/gen/android/app/build/
**/gen/android/build/
**/gen/android/.gradle/
**/gen/android/local.properties
**/gen/apple/build/
**/gen/apple/*.xcodeproj/xcuserdata/
*.apk
*.aab
*.dex
*.jks
*.keystore

# ─────────────────────────────────────────────────────────────────────────
# Poids des modèles, environnements et caches
#
# Des dizaines de gigaoctets qui n'ont rien à faire dans une forge : les
# poids se téléchargent, l'environnement se reconstruit.
# ─────────────────────────────────────────────────────────────────────────
models/
hf_cache/
.venv/
venv/
__pycache__/
*.pyc
*.gguf
*.safetensors
*.onnx
*.bin
!**/gradle/wrapper/gradle-wrapper.jar

# ─────────────────────────────────────────────────────────────────────────
# Données locales et dossiers de travail
# ─────────────────────────────────────────────────────────────────────────
*.db
*.db-journal
*.db-shm
*.db-wal
.locaryn/
.locaryn-*/
.lochor/
.lochor-*/
tmp/
locaryn_tmp/
lochor_tmp/
release/
clothes_test/
voice_clone_test/
# Compagnons de l'application de bureau (service + CLI) : recopiés depuis
# target/ au moment de l'empaquetage, jamais versionnés.
apps/desktop/src-tauri/binaries/
# Sorties de mise au point déposées à la racine. Un `git add .` les a déjà
# publiées une fois dans le dépôt public (redirections de commandes gh,
# extraits de catalogue, un .wav de test de clonage vocal).
/tmp_*.txt
/out.txt
/gh_status.txt
/help_clone.txt
/remotes.txt
/check_repos.txt
/repo_create.txt
/*.wav

# ─────────────────────────────────────────────────────────────────────────
# Assistants de code / IA
#
# Dossiers locaux créés par les assistants de code : réglages machine,
# historiques, caches et bases locales n'ont rien à faire dans la forge.
# Les instructions partagées (CLAUDE.md, AGENTS.md) restent suivies — seul
# le local est ignoré. Comme pour .vscode, un lanceur délibérément partagé
# (.claude/launch.json) garde une exception.
# ─────────────────────────────────────────────────────────────────────────
.claude/
!.claude/launch.json
.freebuff/
.cursor/
.cursorignore
.codex/
.codebuff/
.windsurf/
.cline/
.roo/
.continue/
.aider*
.gemini/
.qwen/
.kiro/

# ─────────────────────────────────────────────────────────────────────────
# IDE
# ─────────────────────────────────────────────────────────────────────────
.idea/
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
*.swp
.DS_Store
Thumbs.db

# ─────────────────────────────────────────────────────────────────────────
# Environnement et secrets
# ─────────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
!**/*.pub.key

# ─────────────────────────────────────────────────────────────────────────
# Divers
# ─────────────────────────────────────────────────────────────────────────
*.log
coverage/

# Extension personnelle, hors du dépôt de l'application

# ── Extension SnapMCP / astreinte ──────────────────────────────────────
# Produit distinct, avec son propre dépôt. Le garder ici en ferait deux
# sources de vérité pour une même chose, et un lanceur versionné qui pointe
# vers un dossier absent du dépôt ne peut fonctionner chez personne.
.snap-astreinte/
Lancer-SnapMCP.bat
Lancer-Banc-SnapMCP.bat
.snapmcp/
.updater-keys/
# Clé de signature Android : même statut que la clé de l'updater — elle vit sur
# la machine du propriétaire et dans les secrets GitHub, jamais ici.
.android-keys/

# Les extensions sont des produits distincts, avec leur propre dépôt.
plugins/

# Sortie de compilation Gradle du greffon vendored — se régénère à chaque
# build, ne doit jamais être commitée.
vendor/*/android/build/
vendor/*/android/**/build/
vendor/*/android/.gradle/
