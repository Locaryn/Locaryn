{
  "PreToolUse": [
    {
      "matcher": "WriteFile",
      "hooks": [
        {
          "type": "command",
          "command": "bash ${LOCARYN_MORPH_ROOT}/hooks/validate.sh",
          "timeout": 30
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "command": "echo [locaryn] tool completed >> ${LOCARYN_PROJECT_ROOT}/.locaryn/tool.log"
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [{ "type": "command", "command": "echo done" }]
    }
  ]
}
